# OE5XRX boot STAGE 2 (template; rendered + compiled to /boot/boot-stage2.scr).
#
# Lives INSIDE the A/B slot's rootfs, so it is updated by OTA and rolled back
# with the slot. Sourced by stage 1 (boot.scr on FAT, frozen) AFTER stage 1 has
# done env defaults, bootcount, watchdog and the rollback decision.
#
# Inputs from stage 1 (env): oe5xrx_devtype, oe5xrx_devnum, root_partnum,
# boot_part; plus the U-Boot/firmware defaults fdt_addr (firmware DTB with the
# config.txt patches applied), fdt_addr_r, kernel_addr_r, ramdisk_addr_r.
#
# Rules (enforced by tests/ota-integration/test_boot_scripts_static.py):
#   - NEVER touch bootcount / upgrade_available / boot_part, NEVER saveenv —
#     a broken stage 2 must not be able to break the rollback.
#   - NEVER modify the firmware DTB at ${fdt_addr}: overlays are applied to a
#     COPY at ${fdt_addr_r}. A failed `fdt apply` corrupts the tree it was
#     applied to, so on any overlay failure the copy is discarded, re-copied
#     from ${fdt_addr} and the station boots WITHOUT any overlay (never with a
#     half-patched tree), tagged oe5xrx.overlays=failed:<name>.
#   - No `exit`/`return`: on any error just fall off the end of the script;
#     stage 1 then boots its frozen fallback (oe5xrx.stage2=failed).
#   - This file is the authoritative source of the kernel bootargs.
#
# Memory layout (HW-CHECK on real CM4): the DTB work copy at ${fdt_addr_r} sits
# 1 MiB below ${ramdisk_addr_r} (overlay load buffer; rpi defaults 0x02600000 /
# 0x02700000). The kernel is loaded at ${kernel_addr_r}, so this requires
# kernel_addr_r + size(/boot/Image) < fdt_addr_r — a kernel Image growing past
# that would be overwritten by the DTB copy. Verify against the shipped Image.
#
# Build-time placeholders (written @NAME@ in the code; filled by the recipe and
# by tests/ota-integration/boot_scripts.py render_stage2 with the same rules):
#   OE5XRX_DT_OVERLAYS       space-separated overlay names (may be empty)
#   OE5XRX_DT_OVERLAYS_CSV   comma-separated overlay names
#   OE5XRX_OVERLAYS_BOOTARG  " oe5xrx.overlays=ok:<csv>", or empty if no overlays
# Overlay names must match [a-z0-9-]+ (no hush/bootargs metacharacters).

echo "=== OE5XRX boot stage 2 (slot ${boot_part}) ==="
echo "  Overlays: @OE5XRX_DT_OVERLAYS_CSV@"
echo "  Loading kernel from rootfs ${oe5xrx_devtype} ${oe5xrx_devnum}:${root_partnum} (/boot/Image)"
if ext4load ${oe5xrx_devtype} ${oe5xrx_devnum}:${root_partnum} ${kernel_addr_r} /boot/Image; then
    # Copy the firmware DTB into the work area and make room for overlays.
    # Every step of the copy is gated (&&): booti below only runs while
    # oe5xrx_fdt_ok=1, i.e. after a copy that fully succeeded — a failed copy
    # or re-copy never boots, stage 2 falls off the end instead.
    setenv oe5xrx_fdt_ok
    if test -n "${fdt_addr}" && fdt addr ${fdt_addr} && fdt move ${fdt_addr} ${fdt_addr_r} && fdt addr ${fdt_addr_r} && fdt resize 0x10000; then
        setenv oe5xrx_fdt_ok 1

        # Apply the slot's overlays; stop at the first failure.
        setenv oe5xrx_ovl_failed
        for o in @OE5XRX_DT_OVERLAYS@; do
            if test -z "${oe5xrx_ovl_failed}"; then
                setenv oe5xrx_ovl_failed ${o}
                echo "  Applying overlay /boot/overlays/${o}.dtbo"
                if ext4load ${oe5xrx_devtype} ${oe5xrx_devnum}:${root_partnum} ${ramdisk_addr_r} /boot/overlays/${o}.dtbo; then
                    if fdt apply ${ramdisk_addr_r}; then
                        setenv oe5xrx_ovl_failed
                    fi
                fi
            fi
        done

        if test -n "${oe5xrx_ovl_failed}"; then
            # The copy may be corrupt: discard it, re-copy the pristine
            # firmware DTB and boot WITHOUT any overlay — only if the re-copy
            # fully succeeded.
            echo "  Overlay ${oe5xrx_ovl_failed} failed — booting without overlays"
            setenv oe5xrx_ovl_bootarg " oe5xrx.overlays=failed:${oe5xrx_ovl_failed}"
            setenv oe5xrx_fdt_ok
            if test -n "${fdt_addr}" && fdt addr ${fdt_addr} && fdt move ${fdt_addr} ${fdt_addr_r} && fdt addr ${fdt_addr_r} && fdt resize 0x10000; then
                setenv oe5xrx_fdt_ok 1
            fi
        else
            setenv oe5xrx_ovl_bootarg "@OE5XRX_OVERLAYS_BOOTARG@"
        fi
    fi

    if test "${oe5xrx_fdt_ok}" = 1; then
        setenv bootargs "root=PARTLABEL=root_${boot_part} ro rootwait fsck.repair=yes net.ifnames=0 panic=5 softlockup_panic=1 reserve_mem=2M:4096:oops ramoops.mem_name=oops ramoops.ecc=1 ramoops.record_size=0x40000 ramoops.console_size=0x40000 ramoops.pmsg_size=0x40000 console=tty1 console=serial0,115200 oe5xrx.stage2=ok${oe5xrx_ovl_bootarg}"
        echo "  Booting with firmware DTB copy at ${fdt_addr_r}"
        booti ${kernel_addr_r} - ${fdt_addr_r}
    fi
fi
echo "  Stage 2 could not boot — returning to stage 1"
