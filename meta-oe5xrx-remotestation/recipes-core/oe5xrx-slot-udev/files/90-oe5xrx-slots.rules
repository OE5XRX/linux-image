# OE5XRX slot contract — real-HW half (D2, spec §3a).
# BusBoard FE1.1s hub ports are fixed-wired: port = slot.
# The FM module's CDC-ACM (control) interface is a child of the hub port.
# Two identical modules are told apart by PORT PATH only, never serial.
# Only slotN/control (CDC-ACM/tty) is in D2 scope. audio (UAC2) and dfu are later deliverables.
# Match KERNEL=="ttyACM*": the control interface is CDC-ACM, so this ignores unrelated
# USB serial devices (e.g. an FTDI ttyUSB) that might share a hub port path.
ACTION=="remove", GOTO="oe5xrx_slots_end"

SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", SUBSYSTEMS=="usb", KERNELS=="1-1.1", SYMLINK+="oe5xrx/slot1/control"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", SUBSYSTEMS=="usb", KERNELS=="1-1.2", SYMLINK+="oe5xrx/slot2/control"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", SUBSYSTEMS=="usb", KERNELS=="1-1.3", SYMLINK+="oe5xrx/slot3/control"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", SUBSYSTEMS=="usb", KERNELS=="1-1.4", SYMLINK+="oe5xrx/slot4/control"

# --- Audio half of the slot contract (Spec 0 §4/§8) ------------------------
# ALSA sound devices cannot carry stable /dev symlinks the way tty does (the
# agent consumes PipeWire NODES, not /dev/snd paths). So instead of a symlink we
# TAG the sound device with its slot number; WirePlumber reads OE5XRX_SLOT and
# renames the node to the stable "oe5xrx.slotN" (see 51-oe5xrx-slot-naming.conf).
#
# Real HW: the module's UAC2 sound card is a child of the fixed FE1.1s hub port,
# told apart by PORT PATH only (never serial), exactly like the control tty.
SUBSYSTEM=="sound", KERNELS=="1-1.1", ENV{OE5XRX_SLOT}="1", ENV{OE5XRX_SLOT_ROLE}="audio"
SUBSYSTEM=="sound", KERNELS=="1-1.2", ENV{OE5XRX_SLOT}="2", ENV{OE5XRX_SLOT_ROLE}="audio"
SUBSYSTEM=="sound", KERNELS=="1-1.3", ENV{OE5XRX_SLOT}="3", ENV{OE5XRX_SLOT_ROLE}="audio"
SUBSYSTEM=="sound", KERNELS=="1-1.4", ENV{OE5XRX_SLOT}="4", ENV{OE5XRX_SLOT_ROLE}="audio"
# Sim: the snd-aloop card is loaded by the sim-harness with a stable id
# (modprobe snd-aloop id=oe5xrxslot1). Matching that id sets the SAME slot tag,
# so PipeWire/WirePlumber resolve "oe5xrx.slot1" identically in sim and on real
# HW (Spec 0 §8 "identische Node-Auflösung in QEMU").
SUBSYSTEM=="sound", ATTRS{id}=="oe5xrxslot1", ENV{OE5XRX_SLOT}="1", ENV{OE5XRX_SLOT_ROLE}="audio"

LABEL="oe5xrx_slots_end"
