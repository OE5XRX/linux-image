[Unit]
Description=OE5XRX system-wide PipeWire multimedia daemon
Documentation=https://oe5xrx.org/docs/remote-station/
# Headless appliance: PipeWire runs SYSTEM-WIDE (Spec 0 §2.7), not per-user.
# There is no logind session, so this is a plain system service owned by the
# dedicated 'pipewire' user (created by the pipewire package).
After=dbus.service
Wants=dbus.service
# A persistent socket/config failure must not become a tight restart loop that
# floods the journal.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pipewire
Group=pipewire
# /run/pipewire holds the pipewire-0 socket. RuntimeDirectory is 0750
# pipewire:pipewire so a group-'pipewire' member (the station_agent, Session B —
# a different user) can traverse in. UMask=0007 makes the protocol-native socket
# group-accessible (0770-ish) and denies everyone else, so a Session-B client in
# group 'pipewire' can connect() while non-members cannot. This
# dir + group + umask triple is the Session-B interface contract.
RuntimeDirectory=pipewire
RuntimeDirectoryMode=0750
UMask=0007
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
ExecStart=/usr/bin/pipewire
Restart=on-failure
RestartSec=2
# System-wide PipeWire cannot use per-user RTKit for realtime scheduling; grant
# the rlimits directly so the RT module can raise priority (glitch-free audio).
# A bounded MEMLOCK (not infinity) is enough for the RT pool and is the safer
# default for a network-facing appliance daemon.
LimitRTPRIO=88
LimitMEMLOCK=64M

[Install]
WantedBy=multi-user.target
