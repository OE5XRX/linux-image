# ydev config — copy to .env (git-ignored) and fill in. `just init` does this.
# Local builds read the public R2 sstate mirror (https://sstate.oe5xrx.org/) — no mount needed.
# --- Remote backend (Plan B: `just remote …`) — fill when needed ---
#HCLOUD_TOKEN=
#BWS_ACCESS_TOKEN=
#BWS_SERVER_URL=https://vault.bitwarden.eu
#HCLOUD_SSH_KEY_NAME=
# Private key matching HCLOUD_SSH_KEY_NAME, if it isn't your ssh default (~/.ssh/id_*).
# Needed so ssh can reach the box without a password prompt.
#HCLOUD_SSH_KEY=~/.ssh/yocto-builder
#YDEV_SERVER_TYPE=ccx43
#YDEV_LOCATION=fsn1
#YDEV_IDLE_MINUTES=30
#YDEV_MAX_HOURS=4
